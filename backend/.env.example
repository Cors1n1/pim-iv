# ==============================================================================
# CondoHub - Modelo de Configuração de Ambiente (.env.example)
# Renomeie este arquivo para .env e preencha com as suas configurações locais
# ==============================================================================

PROJECT_NAME="CondoHub - Sistema de Gestão Condominial"
SECRET_KEY="sua_chave_secreta_jwt_deve_ser_alterada_aqui"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Conexão com o PostgreSQL
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="sua_senha_postgresql"
DB_NAME="sgc_condominio"

# String de conexão assíncrona (asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:sua_senha_postgresql@localhost:5432/sgc_condominio"

# Envio de E-mails (SMTP)
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME="seu_email@gmail.com"
MAIL_PASSWORD="sua_senha_de_aplicativo"
MAIL_DEFAULT_SENDER="seu_email@gmail.com"
MAIL_TLS=True
MAIL_SSL=False
MAIL_SENDER_NAME="CondoHub"

# Segurança Adicional (Opcional - deixe vazio em desenvolvimento local)
CONSOLE_ALLOWED_IPS=""
SUPERADMIN_ALLOWED_IPS=""
TRUSTED_PROXIES=""
