/* ====================================================================
   SGC - Sistema de Gestão de Condomínio | PIM IV UNIP ADS
   Visual sóbrio: fundo neutro, cor única de destaque, sem gradientes,
   sem brilhos e com ícones só onde ajudam (ações). Acessibilidade mantida
   (fonte maior, alto contraste, foco visível).
   ==================================================================== */

:root {
  --bg-page: #f2f5fa;
  --bg-card: #ffffff;
  --bg-subtle: #ebeff6;
  --bg-hover: #e1e7f1;
  --bg-input: #ffffff;

  --text-main: #141c2b;
  --text-muted: #556073;
  --text-dim: #8590a3;
  --text-on-primary: #ffffff;

  --border-color: #d7deea;
  --border-subtle: #e8ecf4;
  --border-strong: #b3bdd0;
  --focus-ring: #1d4ed8;

  --primary: #1d4ed8;
  --primary-hover: #1740b5;
  --primary-dark: #0b1f4d;
  --primary-light: #e7eefc;
  --primary-border: #b4c8f2;
  --primary-glow: transparent;

  --success: #2f6b3f;
  --success-bg: #e8f1ea;
  --success-border: #b9d3bf;
  --success-glow: transparent;
  --warning: #8a5a10;
  --warning-bg: #f6edd9;
  --warning-border: #e2cf9f;
  --warning-glow: transparent;
  --danger: #a1302a;
  --danger-bg: #f7e6e4;
  --danger-border: #e3b9b5;
  --danger-glow: transparent;
  --info: #0e6e8c;
  --info-bg: #e3f2f7;
  --info-border: #aed5e2;
  --info-glow: transparent;
  --violet: #5b4a7a;
  --violet-bg: #ece8f2;
  --violet-border: #cdc4dd;
  --violet-glow: transparent;

  /* Paleta Arquitetônica Residencial (Azul Marinho Sóbrio + Tons Pastéis Areia/Linho/Marrom Claro) */
  --navy-deep: #0b1a33;
  --navy-surface: #122442;
  --navy-accent: #1e3a64;
  --navy-border: #213c66;

  --warm-sand: #f4efe8;
  --warm-sand-light: #fbf9f6;
  --warm-sand-border: #ded5c7;
  --warm-sand-hover: #ece3d5;
  --warm-brown: #8a6843;
  --warm-brown-hover: #755532;
  --warm-brown-light: #ad8a64;
  --warm-brown-subtle: #fbf8f3;
  --warm-brown-border: #d8c9b6;

  --radius-xs: 3px;
  --radius-sm: 4px;
  --radius: 6px;
  --radius-lg: 8px;
  --radius-xl: 8px;

  --font-base-size: 16px;
  --font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --font-display: 'Source Serif 4', Georgia, 'Times New Roman', serif;

  --shadow-xs: none;
  --shadow-sm: none;
  --shadow-md: 0 1px 3px rgba(31, 36, 33, 0.08);
  --shadow-lg: 0 2px 8px rgba(31, 36, 33, 0.08);
  --shadow-floating: 0 8px 24px rgba(31, 36, 33, 0.18);

  --transition: background-color .15s ease, border-color .15s ease, color .15s ease;
  --sidebar-w: 248px;
}

body.large-font { --font-base-size: 19px; }

body.high-contrast {
  --bg-page: #000000;
  --bg-card: #000000;
  --bg-subtle: #0d0d0d;
  --bg-hover: #1f1f1f;
  --bg-input: #000000;
  --text-main: #ffffff;
  --text-muted: #ffff66;
  --text-dim: #ffff99;
  --text-on-primary: #000000;
  --border-color: #ffffff;
  --border-subtle: #333333;
  --border-strong: #ffffff;
  --focus-ring: #ffff00;
  --primary: #ffff00;
  --primary-hover: #ffffff;
  --primary-dark: #000000;
  --primary-light: #1f1f00;
  --primary-border: #ffff00;
  --success: #66ff99;
  --success-bg: #002b12;
  --success-border: #66ff99;
  --warning: #ffd966;
  --warning-bg: #2b1f00;
  --warning-border: #ffd966;
  --danger: #ff8080;
  --danger-bg: #2b0000;
  --danger-border: #ff8080;
  --info: #7fc4ff;
  --info-bg: #001a2e;
  --info-border: #7fc4ff;
  --violet: #cdb3ff;
  --violet-bg: #170a2e;
  --violet-border: #cdb3ff;
  --shadow-md: none;
  --shadow-lg: none;
  --shadow-floating: none;
}

/* ---------- Base ---------- */
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  font-size: var(--font-base-size);
  line-height: 1.55;
  background: var(--bg-page);
  color: var(--text-main);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  -webkit-font-smoothing: antialiased;
}

.hidden { display: none !important; }
:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; }
button { font-family: inherit; cursor: pointer; }

.ico {
  width: 20px; height: 20px;
  fill: none; stroke: currentColor;
  stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
  flex-shrink: 0;
}
.ico-sm { width: 16px; height: 16px; }
.ico-xs { width: 14px; height: 14px; }

/* Ícones de interface e navegação */
.nav-item .ico,
.stat-icon .ico,
.module-icon .ico,
.window-icon .ico,
.role-icon-lg .ico,
.btn-secondary .ico,
.btn-window-back .ico,
.btn-primary-sm .ico,
.btn-action-deliver .ico,
.btn-action-danger .ico,
.btn-action-primary .ico,
.btn-action-warning .ico { display: inline-block; }

.privacy-note .ico,
.brand-mark { display: none !important; }

/* ---------- Barra superior ---------- */
.top-bar {
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-color);
  padding: 8px 24px;
  position: sticky; top: 0; z-index: 50;
}
.top-bar-content {
  max-width: 1480px; margin: 0 auto;
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 10px;
}
.brand-mini {
  display: flex; align-items: center; gap: 8px;
  font-weight: 600; font-size: 0.88rem; color: var(--text-main);
}
.brand-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--primary); }

.accessibility-controls { display: flex; align-items: center; gap: 8px; }
.acc-btn {
  display: inline-flex; align-items: center; gap: 6px;
  background: transparent;
  border: 1px solid var(--border-strong);
  color: var(--text-main);
  padding: 6px 12px; border-radius: var(--radius);
  font-size: 0.84rem; font-weight: 500;
  min-height: 36px; transition: var(--transition);
}
.acc-btn:hover { background: var(--bg-hover); }
.acc-btn .ico { display: none; }
.acc-glyph { font-weight: 700; }

.main-wrapper { flex: 1; display: flex; flex-direction: column; }

/* ====================================================================
   LOGIN (INSTITUCIONAL RESIDENCIAL: AZUL CORPORATIVO / MARINHO & ARQUITETÔNICO)
   ==================================================================== */
.auth-layout {
  flex: 1;
  display: grid;
  grid-template-columns: minmax(430px, 1.1fr) minmax(460px, 1.2fr);
  min-height: calc(100vh - 54px);
}

@media (max-width: 980px) {
  .auth-layout {
    grid-template-columns: 1fr;
  }
}

/* Lado Esquerdo: Hero Institucional Editorial com Azul Predominante */
.auth-hero {
  background: linear-gradient(175deg, #09172e 0%, #0d2244 50%, #112952 100%);
  color: #f1f5f9;
  padding: 54px 50px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  position: relative;
}

@media (max-width: 980px) {
  .auth-hero {
    padding: 36px 24px;
    border-right: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
}

.hero-brand {
  display: flex;
  align-items: center;
  gap: 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  padding-bottom: 22px;
}

.brand-monogram {
  display: inline-flex;
  flex-shrink: 0;
}

.monogram-frame {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1.5px solid rgba(147, 197, 253, 0.45);
  padding: 8px 15px;
  border-radius: 8px;
  background: rgba(30, 58, 138, 0.35);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
}

.monogram-letter {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.1rem;
  letter-spacing: 0.16em;
  color: #ffffff;
}

.brand-headings {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hero-brand-kicker {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #93c5fd;
}

.hero-brand-title {
  font-family: var(--font-display);
  font-size: 1.55rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.01em;
  margin: 0;
  line-height: 1.2;
}

.hero-brand-sub {
  font-size: 0.84rem;
  color: #cbd5e1;
  font-weight: 500;
}

.hero-body {
  max-width: 520px;
  margin: 32px 0;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.hero-manifesto {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.hero-manifesto-title {
  font-family: var(--font-display);
  font-size: 1.22rem;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
  margin: 0;
}

.hero-manifesto-text {
  font-size: 0.88rem;
  color: #94a3b8;
  line-height: 1.55;
  margin: 0;
}

.hero-pillars {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.pillar-card {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  padding: 12px 14px;
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  transition: all .2s ease;
}

.pillar-card:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(147, 197, 253, 0.3);
  transform: translateX(3px);
}

.pillar-icon {
  width: 34px;
  height: 34px;
  border-radius: 6px;
  background: rgba(29, 78, 216, 0.25);
  color: #93c5fd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid rgba(147, 197, 253, 0.2);
  margin-top: 1px;
}

.pillar-icon .ico {
  display: block !important;
}

.pillar-content strong {
  display: block;
  font-size: 0.92rem;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 2px;
  line-height: 1.3;
}

.pillar-content span {
  display: block;
  font-size: 0.82rem;
  line-height: 1.45;
  color: #94a3b8;
}

.hero-location-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  font-size: 0.82rem;
  color: #cbd5e1;
  font-weight: 500;
  width: fit-content;
}

.hero-location-chip .ico {
  display: block !important;
  color: #93c5fd;
}

.hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.09);
  font-size: 0.8rem;
  color: #94a3b8;
}

.foot-status {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-indicator-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 0 2px rgba(52, 211, 153, 0.25);
  flex-shrink: 0;
}

.foot-version {
  font-size: 0.78rem;
  color: #64748b;
  font-weight: 500;
}

/* Lado Direito: Painel de Acesso Corporativo Limpo */
.auth-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 28px;
  background: #f1f5f9;
}

@media (max-width: 480px) {
  .auth-panel {
    padding: 24px 14px;
  }
}

.auth-card {
  width: 100%;
  max-width: 460px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-top: 4px solid #1d4ed8;
  border-radius: 10px;
  padding: 38px 34px;
  box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.07), 0 4px 10px -2px rgba(15, 23, 42, 0.03);
}

@media (max-width: 480px) {
  .auth-card {
    padding: 28px 18px;
  }
}

.auth-header {
  margin-bottom: 22px;
}

.auth-kicker {
  display: inline-block;
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #1d4ed8;
  margin-bottom: 6px;
}

.auth-title {
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 700;
  letter-spacing: -0.015em;
  color: #0c1e3d;
  line-height: 1.22;
}

.auth-subtitle {
  margin-top: 6px;
  color: #475569;
  font-size: 0.88rem;
  line-height: 1.5;
}

.alert-box {
  padding: 12px 15px;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 500;
  margin-bottom: 20px;
  border: 1px solid transparent;
}
.alert-box.error {
  background: var(--danger-bg);
  color: var(--danger);
  border-color: var(--danger-border);
}
.alert-box.success {
  background: var(--success-bg);
  color: var(--success);
  border-color: var(--success-border);
}

.auth-form {
  display: grid;
  gap: 18px;
}

.form-group {
  display: grid;
  gap: 6px;
}

.form-group label {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-weight: 600;
  font-size: 0.88rem;
  color: #0f172a;
}

.label-hint {
  font-size: 0.78rem;
  font-weight: 400;
  color: #64748b;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input-leading-icon {
  position: absolute;
  left: 14px;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 2;
}

.input-leading-icon .ico {
  display: block !important;
}

.input-wrapper input {
  width: 100%;
  padding: 12px 42px 12px 42px;
  border: 1.5px solid #cbd5e1;
  border-radius: 6px;
  font-family: inherit;
  font-size: 0.95rem;
  background: #ffffff;
  color: #0f172a;
  min-height: 48px;
  transition: border-color .15s ease, box-shadow .15s ease;
}

.input-wrapper input::placeholder {
  color: #94a3b8;
}

.input-wrapper input:hover {
  border-color: #94a3b8;
}

.input-wrapper input:focus {
  outline: none;
  border-color: #1d4ed8;
  box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.14);
}

.caps-warning {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 0.8rem;
  font-weight: 500;
  color: #8a5a10;
  background: #fdf6e7;
  border: 1px solid #ebd7a3;
  padding: 7px 10px;
  border-radius: 4px;
  margin-top: 6px;
}

.caps-warning .ico {
  display: block !important;
}

.btn-toggle-eye {
  position: absolute;
  right: 6px;
  background: transparent;
  border: none;
  color: #64748b;
  width: 38px;
  height: 38px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--transition);
}

.btn-toggle-eye .ico {
  display: block !important;
}

.btn-toggle-eye:hover {
  color: #0c1e3d;
  background: #f1f5f9;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  background: #0f284f;
  color: #ffffff;
  border: 1px solid #0f284f;
  padding: 13px 20px;
  border-radius: 6px;
  font-size: 0.98rem;
  font-weight: 600;
  min-height: 48px;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(15, 40, 79, 0.2);
  transition: background-color .15s ease, border-color .15s ease, transform .1s ease, box-shadow .15s ease;
}

.btn-primary:hover {
  background: #0a1b36;
  border-color: #0a1b36;
  box-shadow: 0 4px 12px rgba(15, 40, 79, 0.28);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: translateY(0);
  box-shadow: 0 1px 3px rgba(15, 40, 79, 0.2);
}

.btn-primary:disabled {
  opacity: 0.7;
  cursor: wait;
}

.spinner {
  width: 18px;
  height: 18px;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Caixa de Apoio Institucional */
.auth-support-box {
  margin-top: 18px;
  padding: 12px 14px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-left: 3px solid #3b82f6;
  border-radius: 6px;
  display: flex;
  gap: 11px;
  align-items: flex-start;
}

.support-box-icon {
  color: #2563eb;
  flex-shrink: 0;
  margin-top: 2px;
}

.support-box-icon .ico {
  display: block !important;
}

.support-box-text strong {
  display: block;
  font-size: 0.84rem;
  font-weight: 600;
  color: #1e3a8a;
  margin-bottom: 2px;
}

.support-box-text p {
  margin: 0;
  font-size: 0.8rem;
  color: #475569;
  line-height: 1.45;
}

/* Perfis de Demonstração / Acesso Rápido Sóbrio */
.demo-profiles {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid #e2e8f0;
}

.demo-header {
  margin-bottom: 11px;
}

.demo-title {
  font-size: 0.82rem;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.demo-subtitle {
  font-size: 0.74rem;
  color: #64748b;
  display: block;
  margin-top: 2px;
}

.demo-buttons {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.btn-chip {
  display: flex;
  align-items: center;
  gap: 9px;
  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  padding: 9px 10px;
  border-radius: 6px;
  cursor: pointer;
  text-align: left;
  transition: all .15s ease;
  min-height: 52px;
}

.chip-icon-box {
  width: 28px;
  height: 28px;
  border-radius: 5px;
  background: #e2e8f0;
  color: #475569;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all .15s ease;
}

.chip-icon-box .ico {
  display: block !important;
}

.chip-data {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chip-role {
  font-size: 0.86rem;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.2;
}

.chip-scope {
  font-size: 0.7rem;
  color: #64748b;
  line-height: 1.2;
  margin-top: 2px;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.btn-chip:hover {
  background: #f1f5f9;
  border-color: #cbd5e1;
}

.btn-chip:hover .chip-role {
  color: #1d4ed8;
}

.btn-chip.active-profile {
  background: #eff6ff;
  border-color: #1d4ed8;
  box-shadow: 0 2px 8px rgba(29, 78, 216, 0.15);
}

.btn-chip.active-profile .chip-icon-box {
  background: #1d4ed8;
  color: #ffffff;
}

.btn-chip.active-profile .chip-role {
  color: #1d4ed8;
}

.btn-chip.active-profile .chip-scope {
  color: #1e40af;
}

@media (max-width: 480px) {
  .demo-buttons {
    grid-template-columns: 1fr;
  }
}

/* Suporte de Alto Contraste para Login */
body.high-contrast .auth-hero {
  background: #000000;
  border-right: 2px solid #ffffff;
}

body.high-contrast .monogram-frame {
  border-color: #ffffff;
  background: #000000;
}

body.high-contrast .monogram-letter {
  color: #ffffff;
}

body.high-contrast .pillar-card,
body.high-contrast .hero-location-chip {
  background: #000000;
  border-color: #ffffff;
}

body.high-contrast .hero-brand-kicker,
body.high-contrast .hero-manifesto-title {
  color: #ffff00;
}

body.high-contrast .pillar-content strong {
  color: #ffffff;
}

body.high-contrast .pillar-content span,
body.high-contrast .hero-manifesto-text,
body.high-contrast .hero-location-chip span {
  color: #ffff99;
}

body.high-contrast .auth-panel {
  background: #000000;
}

body.high-contrast .auth-card {
  background: #000000;
  border: 2px solid #ffffff;
  border-top: 4px solid #ffff00;
}

body.high-contrast .auth-title {
  color: #ffffff;
}

body.high-contrast .auth-kicker {
  color: #ffff00;
}

body.high-contrast .auth-subtitle,
body.high-contrast .label-hint,
body.high-contrast .demo-subtitle {
  color: #ffff99;
}

body.high-contrast .form-group label,
body.high-contrast .demo-title {
  color: #ffffff;
}

body.high-contrast .input-wrapper input {
  background: #000000;
  color: #ffffff;
  border: 2px solid #ffffff;
}

body.high-contrast .input-wrapper input:focus {
  border-color: #ffff00;
}

body.high-contrast .btn-primary {
  background: #ffff00;
  color: #000000;
  border-color: #ffff00;
  font-weight: 700;
}

body.high-contrast .auth-support-box {
  background: #000000;
  border: 2px solid #ffffff;
  border-left: 4px solid #ffff00;
}

body.high-contrast .support-box-text strong {
  color: #ffff00;
}

body.high-contrast .support-box-text p {
  color: #ffffff;
}

body.high-contrast .btn-chip {
  background: #000000;
  border: 2px solid #ffffff;
}

body.high-contrast .btn-chip .chip-role {
  color: #ffff00;
}

body.high-contrast .btn-chip .chip-scope {
  color: #ffffff;
}

body.high-contrast .btn-chip.active-profile {
  background: #ffff00;
  border-color: #ffff00;
}

body.high-contrast .btn-chip.active-profile .chip-role,
body.high-contrast .btn-chip.active-profile .chip-scope {
  color: #000000;
}

/* Suporte de Tema Escuro para Login */
body.dark-mode .auth-panel {
  background: #07101d;
}

body.dark-mode .auth-card {
  background: #0c1c33;
  border: 1px solid #1c365d;
  border-top: 4px solid #3b82f6;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
}

body.dark-mode .auth-title {
  color: #ffffff;
}

body.dark-mode .auth-kicker {
  color: #93c5fd;
}

body.dark-mode .auth-subtitle {
  color: #94a3b8;
}

body.dark-mode .form-group label,
body.dark-mode .demo-title {
  color: #ffffff;
}

body.dark-mode .label-hint,
body.dark-mode .demo-subtitle {
  color: #94a3b8;
}

body.dark-mode .input-leading-icon {
  color: #94a3b8;
}

body.dark-mode .input-wrapper input {
  background: #11233d;
  border-color: #213f6b;
  color: #ffffff;
}

body.dark-mode .input-wrapper input:focus {
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
}

body.dark-mode .input-wrapper input::placeholder {
  color: #64748b;
}

body.dark-mode .btn-primary {
  background: #1d4ed8;
  border-color: #1d4ed8;
  color: #ffffff;
}

body.dark-mode .btn-primary:hover {
  background: #1e40af;
  border-color: #1e40af;
}

body.dark-mode .auth-support-box {
  background: #11233d;
  border-color: #264470;
  border-left-color: #3b82f6;
}

body.dark-mode .support-box-text strong {
  color: #93c5fd;
}

body.dark-mode .support-box-text p {
  color: #cbd5e1;
}

body.dark-mode .demo-profiles {
  border-top-color: #1f3960;
}

body.dark-mode .btn-chip {
  background: #11233d;
  border-color: #213f6b;
}

body.dark-mode .chip-icon-box {
  background: #1c365d;
  color: #94a3b8;
}

body.dark-mode .btn-chip .chip-role {
  color: #ffffff;
}

body.dark-mode .btn-chip .chip-scope {
  color: #94a3b8;
}

body.dark-mode .btn-chip:hover {
  background: #193154;
  border-color: #3b82f6;
}

body.dark-mode .btn-chip.active-profile {
  background: #1d4ed8;
  border-color: #1d4ed8;
}

body.dark-mode .btn-chip.active-profile .chip-icon-box {
  background: #1e40af;
  color: #ffffff;
}

body.dark-mode .btn-chip.active-profile .chip-role {
  color: #ffffff;
}

body.dark-mode .btn-chip.active-profile .chip-scope {
  color: #e0e7ff;
}

/* ====================================================================
   APLICAÇÃO
   ==================================================================== */
.app-shell {
  flex: 1; display: grid;
  grid-template-columns: var(--sidebar-w) 1fr;
  min-height: calc(100vh - 54px);
}

.sidebar {
  background: var(--bg-card);
  border-right: 1px solid var(--border-color);
  padding: 22px 14px 16px;
  display: flex; flex-direction: column; gap: 22px;
  position: sticky; top: 54px;
  height: calc(100vh - 54px); overflow-y: auto;
}
.sidebar-brand { padding: 0 10px 14px; border-bottom: 1px solid var(--border-color); }
.sidebar-brand-text { display: flex; flex-direction: column; line-height: 1.3; }
.sidebar-brand-text strong { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; }
.sidebar-brand-text span { font-size: 0.78rem; color: var(--text-muted); }

.side-nav { display: flex; flex-direction: column; gap: 2px; flex: 1; }
.side-label {
  font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--text-dim);
  padding: 0 10px 8px;
}
.nav-item {
  display: flex; align-items: center;
  width: 100%;
  background: transparent; border: none;
  border-left: 3px solid transparent;
  color: var(--text-main);
  padding: 10px 12px; border-radius: 0 var(--radius) var(--radius) 0;
  font-size: 0.95rem; font-weight: 500; text-align: left;
  min-height: 42px; transition: var(--transition);
}
.nav-item:hover { background: var(--bg-hover); }
.nav-item.active {
  background: var(--primary-light);
  border-left-color: var(--primary);
  color: var(--primary); font-weight: 600;
}
body.high-contrast .nav-item.active { background: #000; color: #ffff00; border-left-color: #ffff00; outline: 1px solid #fff; }

.sidebar-user {
  display: flex; align-items: center; gap: 10px;
  padding: 12px 10px; border-top: 1px solid var(--border-color);
}
.user-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--primary); color: var(--text-on-primary);
  display: inline-flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: 0.95rem; flex-shrink: 0;
}
.user-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
.user-name { font-weight: 600; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.role-badge { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; color: var(--text-muted); text-transform: uppercase; }
.btn-logout {
  background: transparent; border: 1px solid var(--border-strong);
  color: var(--text-muted);
  width: 36px; height: 36px; border-radius: var(--radius);
  display: inline-flex; align-items: center; justify-content: center;
  transition: var(--transition); flex-shrink: 0;
}
.btn-logout:hover { background: var(--danger-bg); border-color: var(--danger); color: var(--danger); }

.app-main { padding: 32px 40px 56px; max-width: 1320px; width: 100%; }

/* ---------- Cabeçalho da Visão Geral ---------- */
.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--warm-sand-border);
  margin-bottom: 24px;
}

.overview-title-block {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.overview-kicker {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 2px;
}

.kicker-pill {
  color: var(--warm-brown);
}

.kicker-divider {
  color: #ad9c88;
}

.kicker-sub {
  color: #655b4e;
  letter-spacing: 0.04em;
}

.page-title {
  font-family: var(--font-display);
  font-size: 2.2rem;
  font-weight: 700;
  letter-spacing: -0.015em;
  color: var(--navy-deep);
  line-height: 1.15;
}

.page-sub {
  margin-top: 3px;
  color: #554d42;
  font-size: 0.94rem;
  text-transform: capitalize;
  font-weight: 500;
}

.overview-header-status {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  background: rgba(34, 197, 94, 0.1);
  border: 1px solid rgba(34, 197, 94, 0.3);
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 600;
  color: #1b6338;
}

.quick-support-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  background: #ffffff;
  border: 1px solid var(--warm-sand-border);
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--navy-deep);
}

.quick-support-pill .ico {
  color: var(--warm-brown);
}

/* ====================================================================
   VISÃO GERAL EXECUTIVA & LIMPA (ZERO POLUIÇÃO VISUAL)
   ==================================================================== */
.overview-clean {
  padding: 8px 4px 36px;
  display: flex;
  flex-direction: column;
  gap: 22px;
  max-width: 1400px;
  margin: 0 auto;
}

/* ---------- 1. Cabeçalho Limpo ---------- */
.clean-overview-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  flex-wrap: wrap;
  padding-bottom: 6px;
}

.header-welcome-col {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.welcome-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.82rem;
  color: #64748b;
}

.condo-badge {
  font-weight: 700;
  color: #1d4ed8;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 0.74rem;
  background: #eff6ff;
  padding: 3px 9px;
  border-radius: 5px;
  border: 1px solid #bfdbfe;
}

.meta-dot {
  color: #94a3b8;
}

.header-date {
  font-weight: 500;
  color: #64748b;
  text-transform: capitalize;
}

.welcome-heading {
  font-family: var(--font-display);
  font-size: 1.95rem;
  font-weight: 800;
  color: #0c1e3d;
  margin: 2px 0 0;
  line-height: 1.15;
  letter-spacing: -0.015em;
}

.welcome-sub {
  margin: 0;
  font-size: 0.88rem;
  color: #475569;
  line-height: 1.4;
}

.header-actions-col {
  display: flex;
  align-items: center;
  gap: 9px;
  flex-wrap: wrap;
}

.btn-clean-action {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  color: #0c1e3d;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 9px 15px;
  border-radius: 6px;
  cursor: pointer;
  transition: all .15s ease;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
}

.btn-clean-action:hover {
  background: #0f284f;
  color: #ffffff;
  border-color: #0f284f;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(15, 40, 79, 0.18);
}

.btn-clean-action .ico {
  width: 15px;
  height: 15px;
  color: #2563eb;
  transition: color .15s ease;
}

.btn-clean-action:hover .ico {
  color: #ffffff;
}

/* ---------- 2. Barra de Métricas Essenciais (KPI Cards) ---------- */
.clean-metrics-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
}

.metric-cell {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 18px 20px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  position: relative;
  transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease;
  box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
}

.metric-cell:hover {
  transform: translateY(-2px);
  border-color: #93c5fd;
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.07);
}

.metric-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.metric-label {
  font-size: 0.76rem;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.metric-icon-box {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: #eff6ff;
  color: #2563eb;
  border: 1px solid #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all .15s ease;
}

.metric-cell:hover .metric-icon-box {
  background: #1d4ed8;
  color: #ffffff;
  border-color: #1d4ed8;
}

.metric-num {
  font-family: var(--font-display);
  font-size: 2.1rem;
  font-weight: 700;
  color: #0c1e3d;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.metric-foot {
  font-size: 0.75rem;
  color: #94a3b8;
  font-weight: 500;
  line-height: 1.3;
}

/* ---------- 3. Grade de Conteúdo Direta (2 Colunas Arejadas) ---------- */
.clean-content-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 22px;
  align-items: start;
}

@media (max-width: 980px) {
  .clean-content-grid {
    grid-template-columns: 1fr;
  }
}

.clean-panel {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  overflow: hidden;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  gap: 10px;
}

.panel-title-wrap {
  display: flex;
  align-items: center;
  gap: 9px;
}

.panel-title-wrap .ico {
  width: 17px;
  height: 17px;
  color: #2563eb;
}

.panel-title-wrap h4 {
  margin: 0;
  font-family: var(--font-display);
  font-size: 1.02rem;
  font-weight: 700;
  color: #0c1e3d;
  line-height: 1.2;
}

.panel-link {
  background: none;
  border: none;
  font-size: 0.82rem;
  font-weight: 600;
  color: #1d4ed8;
  cursor: pointer;
  padding: 3px 7px;
  border-radius: 4px;
  transition: all .15s ease;
  white-space: nowrap;
}

.panel-link:hover {
  color: #0c1e3d;
  background: #eff6ff;
  text-decoration: none;
}

.panel-body {
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ---------- 4. Itens do Mural Limpo ---------- */
.clean-notices-feed {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.clean-notice-card {
  padding: 15px 17px;
  border-radius: 6px;
  border: 1px solid #e2e8f0;
  border-left: 3.5px solid #1d4ed8;
  background: #ffffff;
  cursor: pointer;
  transition: all .15s ease;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.clean-notice-card:hover {
  border-color: #93c5fd;
  border-left-color: #0c1e3d;
  background: #f8fafc;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
}

.clean-notice-top {
  display: flex;
  align-items: center;
  gap: 8px;
}

.clean-cat-pill {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 2px 7px;
  border-radius: 4px;
  background: #eff6ff;
  color: #1d4ed8;
  border: 1px solid #bfdbfe;
}

.clean-notice-date {
  font-size: 0.74rem;
  color: #64748b;
}

.clean-badge-link {
  font-size: 0.68rem;
  font-weight: 600;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  padding: 1px 7px;
  border-radius: 3px;
  margin-left: auto;
}

.clean-notice-title {
  margin: 0;
  font-size: 0.96rem;
  font-weight: 700;
  color: #0c1e3d;
  line-height: 1.3;
}

.clean-notice-text {
  margin: 0;
  font-size: 0.83rem;
  color: #475569;
  line-height: 1.48;
}

/* ---------- 5. Itens da Agenda e Encomendas ---------- */
.clean-agenda-feed,
.clean-deliveries-feed {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.clean-agenda-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 13px;
  border-radius: 6px;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  cursor: pointer;
  transition: all .15s ease;
}

.clean-agenda-row:hover {
  background: #ffffff;
  border-color: #93c5fd;
  transform: translateY(-1px);
  box-shadow: 0 3px 8px rgba(15, 23, 42, 0.04);
}

.clean-agenda-row.mine {
  border-left: 3px solid #16a34a;
  background: #f0fdf4;
}

.clean-agenda-timebox {
  min-width: 86px;
  text-align: center;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 5px;
  padding: 5px 3px;
  display: flex;
  flex-direction: column;
  gap: 1px;
  flex-shrink: 0;
}

.clean-agenda-timebox strong {
  font-size: 0.76rem;
  font-weight: 700;
  color: #0c1e3d;
}

.clean-agenda-timebox span {
  font-size: 0.68rem;
  color: #64748b;
}

.clean-agenda-title-line {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.clean-badge-key {
  font-size: 0.68rem;
  font-weight: 700;
  background: #fef3c7;
  color: #92400e;
  border: 1px solid #fde68a;
  padding: 1px 6px;
  border-radius: 3px;
}

.clean-badge-mine {
  font-size: 0.68rem;
  font-weight: 700;
  background: #dcfce7;
  color: #166534;
  border: 1px solid #bbf7d0;
  padding: 1px 6px;
  border-radius: 3px;
}

.panel-sub-section {
  margin-top: 6px;
  padding-top: 14px;
  border-top: 1px solid #e2e8f0;
}

.sub-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 9px;
}

.sub-title {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #64748b;
}

.sub-link {
  background: none;
  border: none;
  font-size: 0.78rem;
  font-weight: 600;
  color: #1d4ed8;
  cursor: pointer;
  padding: 2px 4px;
}

.sub-link:hover {
  text-decoration: underline;
}

.clean-delivery-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  cursor: pointer;
  transition: all .15s ease;
}

.clean-delivery-row:hover {
  background: #ffffff;
  border-color: #93c5fd;
  transform: translateY(-1px);
}

.clean-delivery-icon {
  width: 30px;
  height: 30px;
  border-radius: 5px;
  background: #eff6ff;
  color: #2563eb;
  border: 1px solid #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
  color: var(--navy-deep);
  line-height: 1.2;
}

.panel-link {
  background: none;
  border: none;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--warm-brown);
  cursor: pointer;
  padding: 2px 6px;
  border-radius: 4px;
  transition: all .15s ease;
  white-space: nowrap;
}

.panel-link:hover {
  color: var(--navy-deep);
  text-decoration: underline;
}

.panel-body {
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ---------- 4. Itens do Mural Limpo ---------- */
.clean-notices-feed {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.clean-notice-card {
  padding: 14px 16px;
  border-radius: 6px;
  border: 1px solid var(--warm-sand-border);
  border-left: 3.5px solid var(--warm-brown);
  background: #ffffff;
  cursor: pointer;
  transition: all .15s ease;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.clean-notice-card:hover {
  border-color: var(--warm-brown);
  background: #fdfbf9;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(45, 35, 20, 0.05);
}

.clean-notice-top {
  display: flex;
  align-items: center;
  gap: 8px;
}

.clean-cat-pill {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 2px 6px;
  border-radius: 3px;
  background: var(--warm-sand);
  color: var(--warm-brown);
  border: 1px solid var(--warm-sand-border);
}

.clean-notice-date {
  font-size: 0.74rem;
  color: #8a7f72;
}

.clean-badge-link {
  font-size: 0.68rem;
  font-weight: 600;
  color: #1d4ed8;
  background: rgba(29, 78, 216, 0.08);
  padding: 1px 6px;
  border-radius: 3px;
  margin-left: auto;
}

.clean-notice-title {
  margin: 0;
  font-size: 0.96rem;
  font-weight: 700;
  color: var(--navy-deep);
  line-height: 1.25;
}

.clean-notice-text {
  margin: 0;
  font-size: 0.83rem;
  color: #5c5347;
  line-height: 1.45;
}

/* ---------- 5. Itens da Agenda e Encomendas ---------- */
.clean-agenda-feed,
.clean-deliveries-feed {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.clean-agenda-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 6px;
  border: 1px solid var(--warm-sand-border);
  background: var(--warm-sand-light);
  cursor: pointer;
  transition: all .15s ease;
}

.clean-agenda-row:hover {
  background: #ffffff;
  border-color: var(--warm-brown);
  transform: translateY(-1px);
  box-shadow: 0 3px 8px rgba(45, 35, 20, 0.04);
}

.clean-agenda-row.mine {
  border-left: 3px solid #2f6b3f;
  background: #f7fbf8;
}

.clean-agenda-timebox {
  min-width: 84px;
  text-align: center;
  background: #ffffff;
  border: 1px solid var(--warm-sand-border);
  border-radius: 4px;
  padding: 4px 2px;
  display: flex;
  flex-direction: column;
  gap: 1px;
  flex-shrink: 0;
}

.clean-agenda-timebox strong {
  font-size: 0.76rem;
  font-weight: 700;
  color: var(--navy-deep);
}

.clean-agenda-timebox span {
  font-size: 0.67rem;
  color: #7a6e60;
}

.clean-agenda-details {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.clean-agenda-title-line {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.clean-agenda-title-line strong {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--navy-deep);
}

.clean-badge-mine {
  font-size: 0.65rem;
  font-weight: 700;
  background: #eef7f0;
  color: #2f6b3f;
  border: 1px solid #c0dec4;
  padding: 1px 5px;
  border-radius: 3px;
}

.clean-badge-key {
  font-size: 0.65rem;
  font-weight: 600;
  background: #fef3c7;
  color: #92400e;
  border: 1px solid #fde68a;
  padding: 1px 5px;
  border-radius: 3px;
}

.clean-agenda-sub {
  font-size: 0.76rem;
  color: #7a6e60;
}

/* Bloco integrado de encomendas */
.panel-sub-section {
  border-top: 1px solid var(--warm-sand-border);
  padding-top: 12px;
  margin-top: 4px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sub-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sub-title {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--navy-deep);
}

.sub-link {
  background: none;
  border: none;
  font-size: 0.76rem;
  font-weight: 600;
  color: var(--warm-brown);
  cursor: pointer;
  padding: 0;
}

.sub-link:hover {
  text-decoration: underline;
}

.clean-delivery-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 6px;
  border: 1px solid var(--warm-sand-border);
  background: #ffffff;
  cursor: pointer;
  transition: all .15s ease;
}

.clean-delivery-row:hover {
  border-color: var(--navy-deep);
  transform: translateY(-1px);
  box-shadow: 0 3px 8px rgba(45, 35, 20, 0.04);
}

.clean-delivery-icon {
  width: 32px;
  height: 32px;
  border-radius: 5px;
  background: rgba(180, 83, 9, 0.08);
  color: #b45309;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.clean-delivery-icon .ico {
  width: 16px;
  height: 16px;
  display: block !important;
}

.clean-delivery-details {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.clean-delivery-title-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 6px;
}

.clean-delivery-title-line strong {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--navy-deep);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.clean-badge-pending {
  font-size: 0.65rem;
  font-weight: 700;
  background: #fef3c7;
  color: #92400e;
  padding: 1px 5px;
  border-radius: 3px;
  border: 1px solid #fde68a;
}

.clean-delivery-sub {
  font-size: 0.74rem;
  color: #7a6e60;
}

.clean-delivery-code code {
  font-size: 0.72rem;
  background: var(--warm-sand);
  color: var(--navy-deep);
  padding: 1px 5px;
  border-radius: 3px;
  border: 1px solid var(--warm-sand-border);
}

/* Empty states sutis */
.clean-empty-box {
  padding: 18px 12px;
  text-align: center;
  background: var(--warm-sand-light);
  border: 1px dashed var(--warm-sand-border);
  border-radius: 6px;
}

.clean-empty-box p {
  margin: 0;
  font-size: 0.82rem;
  color: #8a7f72;
}

/* Dark mode overrides para a visão geral limpa */
body.dark-mode .clean-overview-header .condo-badge {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
  color: #e2e8f0;
}

body.dark-mode .welcome-heading {
  color: #f1f5f9;
}

body.dark-mode .welcome-sub {
  color: #94a3b8;
}

body.dark-mode .btn-clean-action {
  background: #1e293b;
  border-color: #334155;
  color: #f1f5f9;
}

body.dark-mode .btn-clean-action:hover {
  background: #3b82f6;
  border-color: #3b82f6;
  color: #ffffff;
}

body.dark-mode .clean-panel {
  background: #0f172a;
  border-color: #1e293b;
}

body.dark-mode .panel-header {
  background: #1e293b;
  border-color: #334155;
}

body.dark-mode .panel-title-wrap h4 {
  color: #f1f5f9;
}

body.dark-mode .metric-cell {
  background: #0f172a;
  border-color: #1e293b;
}

body.dark-mode .metric-num {
  color: #f1f5f9;
}

body.dark-mode .metric-label {
  color: #94a3b8;
}

body.dark-mode .clean-notice-card {
  background: #1e293b;
  border-color: #334155;
}

body.dark-mode .clean-notice-title {
  color: #f1f5f9;
}

body.dark-mode .clean-notice-text {
  color: #94a3b8;
}

body.dark-mode .clean-agenda-row {
  background: #1e293b;
  border-color: #334155;
}

body.dark-mode .clean-agenda-timebox {
  background: #0f172a;
  border-color: #334155;
}

body.dark-mode .clean-agenda-timebox strong {
  color: #f1f5f9;
}

body.dark-mode .clean-delivery-row {
  background: #1e293b;
  border-color: #334155;
}

body.dark-mode .clean-delivery-title-line strong {
  color: #f1f5f9;
}

body.dark-mode .sub-title {
  color: #f1f5f9;
}

body.dark-mode .sub-link {
  color: #93c5fd;
}

body.dark-mode .clean-delivery-sub,
body.dark-mode .clean-agenda-sub {
  color: #94a3b8;
}

body.dark-mode .panel-sub-section {
  border-color: #334155;
}

body.dark-mode .clean-cat-pill {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
  color: #e2e8f0;
}

body.dark-mode .clean-delivery-code code {
  background: rgba(255, 255, 255, 0.08);
  color: #f1f5f9;
  border-color: rgba(255, 255, 255, 0.12);
}


/* ====================================================================
   JANELAS
   ==================================================================== */
.workspace-view { animation: fadeIn 0.15s ease; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.workspace-window { width: 100%; }

.window-frame {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.window-header {
  display: flex; justify-content: space-between; align-items: center;
  gap: 16px; padding: 20px 26px;
  border-bottom: 1px solid var(--border-color);
  flex-wrap: wrap;
}
.window-title-group { display: flex; align-items: center; gap: 14px; min-width: 0; }
.window-breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; margin-bottom: 2px; }
.breadcrumb-link {
  background: none; border: none; padding: 0;
  color: var(--text-muted); font-size: 0.82rem;
}
.breadcrumb-link:hover { color: var(--primary); text-decoration: underline; }
.breadcrumb-sep { color: var(--text-dim); }
.breadcrumb-current { color: var(--text-main); font-weight: 600; }
.window-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
.window-sub { margin-top: 2px; color: var(--text-muted); font-size: 0.92rem; }
.window-actions { display: flex; align-items: center; gap: 10px; }

.btn-window-back {
  display: inline-flex; align-items: center; gap: 6px;
  background: transparent; border: 1px solid var(--border-strong);
  color: var(--text-main);
  padding: 8px 16px; border-radius: var(--radius);
  font-size: 0.9rem; font-weight: 500; min-height: 40px;
  transition: var(--transition);
}
.btn-window-back:hover { background: var(--bg-hover); }

.window-body { padding: 26px; display: flex; flex-direction: column; }
.window-toolbar, .modal-toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
.window-toolbar-split, .modal-toolbar-split { justify-content: space-between; flex-wrap: wrap; }

.audit-counter { font-size: 0.92rem; color: var(--text-muted); }
.audit-counter span { color: var(--text-main); font-weight: 700; }

.btn-primary-sm {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--primary); color: var(--text-on-primary);
  border: 1px solid var(--primary);
  padding: 8px 16px; border-radius: var(--radius);
  font-size: 0.92rem; font-weight: 600; min-height: 40px;
  transition: var(--transition);
}
.btn-primary-sm:hover { background: var(--primary-hover); border-color: var(--primary-hover); }

.btn-secondary-sm {
  display: inline-flex; align-items: center; gap: 6px;
  background: transparent; color: var(--text-main);
  border: 1px solid var(--border-strong);
  padding: 8px 16px; border-radius: var(--radius);
  font-size: 0.92rem; font-weight: 500; min-height: 40px;
  transition: var(--transition);
}
.btn-secondary-sm:hover { background: var(--bg-hover); }

/* Formulários internos */
.form-mini {
  background: var(--bg-subtle);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 20px; margin-bottom: 20px;
}
.form-mini h4 { font-size: 1rem; font-weight: 600; margin-bottom: 14px; }
.form-row { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 12px; }
.form-group-mini { flex: 1; min-width: 190px; display: grid; gap: 5px; align-content: start; }
.form-group-mini.form-grow-2 { flex: 2; }
.form-group-mini.form-full { flex-basis: 100%; }
.form-group-mini label { font-size: 0.86rem; font-weight: 600; }
.form-group-mini input,
.form-group-mini select,
.form-group-mini textarea {
  width: 100%; padding: 10px 12px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius);
  font-family: inherit; font-size: 0.95rem;
  background: var(--bg-input); color: var(--text-main);
  min-height: 44px; transition: var(--transition);
}
.form-group-mini textarea { resize: vertical; min-height: 100px; line-height: 1.5; }
.form-group-mini input:focus,
.form-group-mini select:focus,
.form-group-mini textarea:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-light); }
.form-mini-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }

.section-title-split {
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 12px; margin-bottom: 8px;
}
.area-rules-hint {
  background: var(--bg-subtle);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 10px 14px; font-size: 0.88rem; margin-bottom: 14px;
}

.areas-management-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 14px; margin-top: 14px; }
.area-manage-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 16px; display: flex; flex-direction: column; gap: 12px;
}
.area-manage-card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
.area-manage-card-header h5 { font-size: 1.02rem; font-weight: 600; margin-bottom: 2px; }
.area-manage-card-desc { font-size: 0.84rem; color: var(--text-muted); }
.area-manage-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.area-field-item { display: flex; flex-direction: column; gap: 4px; }
.area-field-item label { font-size: 0.76rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
.area-field-item input {
  padding: 8px 10px; border: 1px solid var(--border-strong);
  border-radius: var(--radius); background: var(--bg-input); color: var(--text-main);
  font-family: inherit; font-size: 0.9rem; min-height: 38px;
}
.area-field-item input:focus { outline: none; border-color: var(--primary); }
.area-manage-card-actions { display: flex; justify-content: flex-end; gap: 8px; }

/* Tabelas */
.table-responsive { overflow-x: auto; border: 1px solid var(--border-color); border-radius: var(--radius); background: var(--bg-card); }
.data-table { width: 100%; border-collapse: collapse; text-align: left; }
.data-table th {
  background: var(--bg-subtle); color: var(--text-muted);
  font-size: 0.76rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;
  padding: 11px 16px; border-bottom: 1px solid var(--border-color); white-space: nowrap;
}
body.high-contrast .data-table th { background: #000; color: #ffff00; border-bottom: 2px solid #fff; }
.data-table td { padding: 13px 16px; border-bottom: 1px solid var(--border-subtle); font-size: 0.93rem; vertical-align: middle; }
.data-table tbody tr:hover { background: var(--bg-subtle); }
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table code {
  font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
  font-size: 0.84rem; background: var(--bg-subtle);
  border: 1px solid var(--border-color); padding: 1px 6px; border-radius: var(--radius-xs);
}
.table-empty { text-align: center; padding: 30px 16px !important; color: var(--text-muted); }
.table-error { text-align: center; padding: 30px 16px !important; color: var(--danger); font-weight: 600; }
.muted { color: var(--text-muted); }

/* Selos de status */
.badge-status {
  display: inline-block;
  padding: 2px 9px; border-radius: var(--radius-xs);
  font-size: 0.78rem; font-weight: 600;
  border: 1px solid transparent; white-space: nowrap;
}
.badge-status.ocupado, .badge-status.entregue, .badge-status.sucesso,
.badge-status.concluido, .badge-status.finalizado { background: var(--success-bg); color: var(--success); border-color: var(--success-border); }
.badge-status.vago { background: var(--bg-subtle); color: var(--text-muted); border-color: var(--border-color); }
.badge-status.pendente { background: var(--warning-bg); color: var(--warning); border-color: var(--warning-border); }
.badge-status.analise { background: var(--info-bg); color: var(--info); border-color: var(--info-border); }
.badge-status.falha, .badge-status.cancelado { background: var(--danger-bg); color: var(--danger); border-color: var(--danger-border); }
.badge-status.procedure, .badge-status.nolocal { background: var(--violet-bg); color: var(--violet); border-color: var(--violet-border); }
.badge-status.mine { background: var(--primary-light); color: var(--primary); border-color: var(--primary-border); margin-left: 6px; }

.privacy-note { color: var(--text-muted); font-style: italic; font-size: 0.88rem; }

/* Botões de ação nas tabelas */
.btn-action-deliver, .btn-action-danger, .btn-action-primary, .btn-action-warning {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 12px; border-radius: var(--radius);
  font-size: 0.84rem; font-weight: 600; min-height: 34px;
  background: transparent; transition: var(--transition);
}
.btn-action-deliver { border: 1px solid var(--success); color: var(--success); }
.btn-action-deliver:hover { background: var(--success); color: #fff; }
.btn-action-danger { border: 1px solid var(--danger); color: var(--danger); }
.btn-action-danger:hover { background: var(--danger); color: #fff; }
.btn-action-primary { border: 1px solid var(--primary); color: var(--primary); }
.btn-action-primary:hover { background: var(--primary); color: var(--text-on-primary); }
.btn-action-warning { border: 1px solid var(--warning); color: var(--warning); }
.btn-action-warning:hover { background: var(--warning); color: #fff; }

/* Auditoria */
.info-box-audit {
  background: var(--bg-subtle);
  border: 1px solid var(--border-color);
  border-left: 4px solid var(--primary);
  border-radius: var(--radius);
  padding: 14px 18px; margin-bottom: 20px;
  font-size: 0.9rem; line-height: 1.6;
}
.info-box-audit code {
  font-family: ui-monospace, Consolas, monospace;
  background: var(--bg-card); border: 1px solid var(--border-color);
  padding: 1px 6px; border-radius: var(--radius-xs); font-size: 0.85rem;
}

/* Mural */
.notices-grid { display: flex; flex-direction: column; gap: 14px; }
.notice-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-left: 4px solid var(--border-strong);
  border-radius: var(--radius);
  padding: 18px 22px;
}
.notice-card.urgente { border-left-color: var(--danger); }
.notice-card.manutencao { border-left-color: var(--info); }
.notice-card.assembleia { border-left-color: var(--violet); }
.notice-card.geral { border-left-color: var(--success); }

.notice-header-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
.notice-date { font-size: 0.82rem; color: var(--text-muted); }
.notice-cat-badge {
  display: inline-block; padding: 2px 9px; border-radius: var(--radius-xs);
  font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  border: 1px solid transparent;
}
.notice-cat-badge.urgente { background: var(--danger-bg); color: var(--danger); border-color: var(--danger-border); }
.notice-cat-badge.manutencao { background: var(--info-bg); color: var(--info); border-color: var(--info-border); }
.notice-cat-badge.assembleia { background: var(--violet-bg); color: var(--violet); border-color: var(--violet-border); }
.notice-cat-badge.geral { background: var(--success-bg); color: var(--success); border-color: var(--success-border); }

.notice-title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; margin-bottom: 6px; }
.notice-message { font-size: 0.96rem; color: var(--text-muted); line-height: 1.65; white-space: pre-line; margin-bottom: 14px; }
.notice-message a { color: var(--primary); text-decoration: underline; word-break: break-all; }

.notice-link-attachment { margin: 6px 0 14px; }
.notice-link-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 16px; border-radius: var(--radius);
  background: transparent; border: 1px solid var(--primary);
  color: var(--primary); font-size: 0.9rem; font-weight: 600;
  text-decoration: none; transition: var(--transition);
}
.notice-link-btn:hover { background: var(--primary); color: var(--text-on-primary); }
.notice-link-btn .ico { display: none; }

.notice-footer {
  display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
  font-size: 0.84rem; color: var(--text-muted);
  border-top: 1px solid var(--border-subtle); padding-top: 10px;
}
.notice-empty {
  text-align: center; padding: 36px 20px; color: var(--text-muted);
  background: var(--bg-subtle);
  border: 1px dashed var(--border-strong); border-radius: var(--radius);
}
.notice-empty strong { display: block; color: var(--text-main); margin-bottom: 4px; }

/* Notificações */
.toast-region {
  position: fixed; right: 24px; bottom: 24px;
  display: flex; flex-direction: column; gap: 10px;
  z-index: 500; max-width: min(420px, calc(100vw - 32px)); pointer-events: none;
}
.toast {
  pointer-events: auto;
  background: var(--text-main); color: var(--bg-card);
  border-left: 4px solid var(--primary-border);
  border-radius: var(--radius);
  padding: 13px 18px;
  box-shadow: var(--shadow-floating);
  font-size: 0.92rem; font-weight: 500; line-height: 1.45;
  animation: toastIn 0.2s ease;
  transition: transform .2s ease, opacity .2s ease;
}
.toast.success { border-left-color: #6fbf86; }
.toast.error { border-left-color: #e07a72; }
body.high-contrast .toast { background: #000; color: #fff; border: 2px solid #fff; }
.toast.leaving { opacity: 0; transform: translateY(8px); }
@keyframes toastIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

/* Diálogos */
.custom-dialog-overlay {
  position: fixed; inset: 0;
  background: rgba(31, 36, 33, 0.55);
  display: flex; align-items: center; justify-content: center;
  padding: 24px; z-index: 1000; animation: fadeIn 0.15s ease;
}
body.high-contrast .custom-dialog-overlay { background: rgba(0, 0, 0, 0.9); }
.custom-dialog-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-floating);
  width: 100%; max-width: 460px; overflow: hidden;
  display: flex; flex-direction: column;
}
body.high-contrast .custom-dialog-card { border: 2px solid #fff; }
.custom-dialog-header { display: flex; align-items: flex-start; gap: 14px; padding: 22px 22px 12px; }
.custom-dialog-headings { flex: 1; min-width: 0; }
.custom-dialog-title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; margin-bottom: 4px; line-height: 1.3; }
.custom-dialog-message { font-size: 0.94rem; color: var(--text-muted); line-height: 1.5; }
.btn-dialog-close {
  background: transparent; border: 1px solid var(--border-color);
  color: var(--text-muted);
  width: 34px; height: 34px; border-radius: var(--radius);
  display: inline-flex; align-items: center; justify-content: center;
  transition: var(--transition); flex-shrink: 0;
}
.btn-dialog-close:hover { background: var(--bg-hover); color: var(--text-main); }
.custom-dialog-body { padding: 6px 22px 16px; display: flex; flex-direction: column; gap: 8px; }
.custom-dialog-label { font-size: 0.88rem; font-weight: 600; }
.custom-dialog-input {
  width: 100%; padding: 11px 13px;
  border: 1px solid var(--border-strong); border-radius: var(--radius);
  background: var(--bg-input); color: var(--text-main);
  font-family: inherit; font-size: 0.95rem;
}
.custom-dialog-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-light); }
.custom-dialog-footer {
  display: flex; justify-content: flex-end; align-items: center; gap: 10px;
  padding: 14px 22px 20px;
  background: var(--bg-subtle); border-top: 1px solid var(--border-color);
}
.btn-dialog-secondary {
  background: transparent; border: 1px solid var(--border-strong); color: var(--text-main);
  padding: 9px 18px; border-radius: var(--radius);
  font-size: 0.92rem; font-weight: 500; min-height: 42px; transition: var(--transition);
}
.btn-dialog-secondary:hover { background: var(--bg-hover); }
.btn-dialog-primary {
  background: var(--primary); border: 1px solid var(--primary); color: var(--text-on-primary);
  padding: 9px 22px; border-radius: var(--radius);
  font-size: 0.92rem; font-weight: 600; min-height: 42px; transition: var(--transition);
}
.btn-dialog-primary:hover { background: var(--primary-hover); border-color: var(--primary-hover); }
.btn-dialog-primary.danger { background: var(--danger); border-color: var(--danger); color: #fff; }
.btn-dialog-primary.danger:hover { background: #82241f; border-color: #82241f; }

/* Filtros e chamados */
.filter-bar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 14px; flex-wrap: wrap; margin-bottom: 16px; padding: 10px 14px;
  background: var(--bg-subtle); border: 1px solid var(--border-color); border-radius: var(--radius);
}
.filter-group { display: flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 500; color: var(--text-muted); }
.filter-group select {
  padding: 6px 12px; border-radius: var(--radius);
  border: 1px solid var(--border-strong); background: var(--bg-input);
  color: var(--text-main); font-size: 0.9rem;
}
.ticket-reply-box {
  background: var(--bg-subtle); border-left: 3px solid var(--primary);
  padding: 8px 12px; border-radius: var(--radius-xs);
  font-size: 0.88rem; line-height: 1.5; margin-top: 6px;
}
.ticket-reply-meta { display: block; font-size: 0.76rem; color: var(--text-muted); margin-top: 4px; }

/* ====================================================================
   RESPONSIVO
   ==================================================================== */
@media (max-width: 1000px) {
  .auth-layout { grid-template-columns: 1fr; }
  .auth-hero { padding: 28px 24px; gap: 24px; }
  .app-shell { grid-template-columns: 1fr; }
  .sidebar {
    position: static; height: auto;
    border-right: none; border-bottom: 1px solid var(--border-color);
    padding: 14px; gap: 12px;
  }
  .side-nav { flex-direction: row; overflow-x: auto; gap: 6px; flex: none; }
  .side-label { display: none; }
  .nav-item { width: auto; white-space: nowrap; flex-shrink: 0; border-left: none; border-bottom: 3px solid transparent; border-radius: var(--radius) var(--radius) 0 0; }
  .nav-item.active { border-bottom-color: var(--primary); }
  .app-main { padding: 22px 16px 44px; }
}
@media (max-width: 560px) {
  .top-bar { padding: 8px 14px; }
  .window-header { padding: 16px 18px; flex-direction: column; align-items: flex-start; }
  .window-body { padding: 18px 14px; }
  .page-title { font-size: 1.6rem; }
  .toast-region { right: 12px; left: 12px; bottom: 12px; max-width: none; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}


/* ====================================================================
   REFINAMENTOS (azul): hierarquia e acabamento
   ==================================================================== */

.btn-primary { box-shadow: 0 1px 2px rgba(11, 31, 77, 0.25); }
.btn-primary:active { transform: translateY(1px); }
.btn-primary-sm { box-shadow: 0 1px 2px rgba(11, 31, 77, 0.2); }

.top-bar { box-shadow: 0 1px 0 rgba(20, 28, 43, 0.03); }
.brand-mini { letter-spacing: 0.01em; }

.sidebar-brand-text strong { color: var(--primary-dark); }
body.high-contrast .sidebar-brand-text strong { color: #fff; }
.nav-item { font-size: 0.94rem; }
.nav-item.active { box-shadow: inset 0 0 0 1px var(--primary-border); }

.page-header { padding-bottom: 14px; border-bottom: 1px solid var(--border-color); margin-bottom: 22px; }
.page-title { color: var(--primary-dark); }
body.high-contrast .page-title { color: #fff; }

.role-context-banner { background: var(--primary-light); border-color: var(--primary-border); }
.role-context-banner.portaria { background: var(--warning-bg); border-color: var(--warning-border); }
.role-context-banner.morador { background: var(--success-bg); border-color: var(--success-border); }
body.high-contrast .role-context-banner { background: #000; border-color: #fff; }

.stat-card {
  border-top: 3px solid var(--primary);
  box-shadow: 0 1px 2px rgba(20, 28, 43, 0.04);
  transition: box-shadow .15s ease, transform .15s ease;
}
.stat-card:hover { box-shadow: 0 6px 16px -8px rgba(20, 28, 43, 0.22); transform: translateY(-1px); }
#cardStatAcessos, #cardStatEncomendas { border-top-color: var(--warning); }
#cardStatReservas { border-top-color: var(--success); }
#cardStatAvisos { border-top-color: var(--violet); }
.stat-value { color: var(--primary-dark); }
body.high-contrast .stat-value { color: #fff; }

.module-card { box-shadow: 0 1px 2px rgba(20, 28, 43, 0.04); transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease; }
.module-card:hover { box-shadow: 0 8px 20px -10px rgba(20, 28, 43, 0.25); transform: translateY(-2px); }

.window-frame { box-shadow: 0 1px 2px rgba(20, 28, 43, 0.05), 0 10px 28px -14px rgba(20, 28, 43, 0.16); }
body.high-contrast .window-frame { box-shadow: none; border: 2px solid #fff; }
.window-header { background: var(--bg-subtle); }
.window-title { color: var(--primary-dark); }
body.high-contrast .window-title { color: #fff; }
body.high-contrast .window-header { background: #000; }

.data-table th { background: var(--primary-light); color: var(--primary-dark); }
.data-table tbody tr:hover { background: #f5f8fe; }
body.high-contrast .data-table th { background: #000; color: #ffff00; }
body.high-contrast .data-table tbody tr:hover { background: #1a1a1a; }

.notice-card { box-shadow: 0 1px 2px rgba(20, 28, 43, 0.04); }
.notice-title { color: var(--primary-dark); }
body.high-contrast .notice-title { color: #fff; }

.custom-dialog-title { color: var(--primary-dark); }
body.high-contrast .custom-dialog-title { color: #fff; }
.custom-dialog-footer { background: var(--bg-subtle); }


/* ====================================================================
   TEMA ARQUITETÔNICO RESIDENCIAL (AZUL MARINHO & ARDÓSIA SUAVE)
   Barra e menu marinho corporativo, fundo ardósia suave, cartões brancos nobres.
   ==================================================================== */
body:not(.high-contrast) {
  --bg-page: #f1f5f9;
  --bg-subtle: #e2e8f0;
  --bg-hover: #cbd5e1;
  --border-color: #cbd5e1;
  --border-subtle: #e2e8f0;
}
body:not(.high-contrast) { background: var(--bg-page); }

/* Barra superior escura e integrada */
body:not(.high-contrast) .top-bar { background: var(--navy-deep); border-bottom: 1px solid var(--navy-border); }
body:not(.high-contrast) .brand-mini { color: #f2f6fc; font-family: var(--font-display); font-size: 0.95rem; }
body:not(.high-contrast) .brand-dot { background: #3b82f6; }
body:not(.high-contrast) .acc-btn { color: #e2ecf9; border-color: rgba(255, 255, 255, 0.2); border-radius: 6px; }
body:not(.high-contrast) .acc-btn:hover { background: rgba(59, 130, 246, 0.15); border-color: #60a5fa; color: #ffffff; }

/* Menu lateral marinho institucional */
body:not(.high-contrast) .sidebar { background: var(--navy-deep); border-right: 1px solid var(--navy-border); }
body:not(.high-contrast) .sidebar-brand { border-bottom-color: rgba(255, 255, 255, 0.1); }
body:not(.high-contrast) .sidebar-brand-text strong { color: #ffffff; font-family: var(--font-display); }
body:not(.high-contrast) .sidebar-brand-text span { color: #a8c1e2; }
body:not(.high-contrast) .side-label { color: #93c5fd; letter-spacing: 0.08em; }
body:not(.high-contrast) .nav-item { color: #dbe5f7; border-radius: 6px; }
body:not(.high-contrast) .nav-item:hover { background: rgba(255, 255, 255, 0.08); color: #ffffff; }
body:not(.high-contrast) .nav-item.active {
  background: rgba(29, 78, 216, 0.24);
  color: #ffffff;
  font-weight: 700;
  border-left-color: #3b82f6;
  box-shadow: inset 0 0 0 1px rgba(59, 130, 246, 0.35);
}
body:not(.high-contrast) .nav-item.active .ico { color: #93c5fd; }
body:not(.high-contrast) .sidebar-user { border-top-color: rgba(255, 255, 255, 0.1); }
body:not(.high-contrast) .user-name { color: #ffffff; font-weight: 600; }
body:not(.high-contrast) .role-badge { color: #93c5fd; font-weight: 700; }
body:not(.high-contrast) .user-avatar { background: #1d4ed8; color: #ffffff; font-weight: 700; }
body:not(.high-contrast) .btn-logout { color: #dbe5f7; border-color: rgba(255, 255, 255, 0.25); }
body:not(.high-contrast) .btn-logout:hover { background: #a1302a; border-color: #a1302a; color: #ffffff; }

.nav-item { gap: 12px; }
.nav-item .ico {
  display: inline-block !important;
  width: 18px; height: 18px; opacity: 0.85;
}
.nav-item.active .ico { opacity: 1; }

/* Conteúdo e cabeçalho */
body:not(.high-contrast) .page-header { border-bottom-color: #cbd5e1; }
body:not(.high-contrast) .page-title { color: var(--navy-deep); }
body:not(.high-contrast) .role-context-banner { background: #ffffff; border-color: #e2e8f0; }
body:not(.high-contrast) .stat-card,
body:not(.high-contrast) .module-card { background: #ffffff; border-color: #e2e8f0; }
body:not(.high-contrast) .module-card:hover { border-color: #1d4ed8; }

/* Janelas: cabeçalho azul marinho com acabamento refinado */
body:not(.high-contrast) .window-frame { background: #ffffff; border-color: #e2e8f0; }
body:not(.high-contrast) .window-header { background: var(--navy-deep); border-bottom: none; }
body:not(.high-contrast) .window-title { color: #ffffff; font-family: var(--font-display); }
body:not(.high-contrast) .window-sub { color: #b8cde8; }
body:not(.high-contrast) .breadcrumb-link { color: #a8c1e2; }
body:not(.high-contrast) .breadcrumb-sep { color: #93c5fd; }
body:not(.high-contrast) .breadcrumb-current { color: #ffffff; }
body:not(.high-contrast) .btn-window-back { color: #ffffff; border-color: rgba(255, 255, 255, 0.35); }
body:not(.high-contrast) .btn-window-back:hover { background: rgba(255, 255, 255, 0.12); }

/* Tabelas */
body:not(.high-contrast) .table-responsive { border-color: #e2e8f0; background: #ffffff; }
body:not(.high-contrast) .data-table th { background: #f1f5f9; color: var(--navy-deep); border-bottom: 2px solid #cbd5e1; font-weight: 700; }
body:not(.high-contrast) .data-table tbody tr:nth-child(even) { background: #f8fafc; }
body:not(.high-contrast) .data-table tbody tr:hover { background: #eff6ff; }
body:not(.high-contrast) .data-table td { border-bottom-color: #e2e8f0; }

/* Formulários e filtros */
body:not(.high-contrast) .form-mini { background: #ffffff; border-color: #e2e8f0; border-left: 4px solid var(--navy-deep); }
body:not(.high-contrast) .filter-bar { background: #f1f5f9; border-color: #e2e8f0; }
body:not(.high-contrast) .area-manage-card { background: #ffffff; border-color: #e2e8f0; }
body:not(.high-contrast) .notice-card { background: #ffffff; border-color: #e2e8f0; border-left-width: 5px; }
body:not(.high-contrast) .notice-empty { background: #f8fafc; }

/* Selos */
.badge-status { font-weight: 700; }
body:not(.high-contrast) .badge-status.vago { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }

/* Tela de login: fundo contemporâneo e suave em ardósia/azul */
body:not(.high-contrast) .auth-panel { background: #f1f5f9; }
body:not(.high-contrast) .auth-card { border-color: #e2e8f0; }

@media (max-width: 1000px) {
  body:not(.high-contrast) .sidebar { background: #10285f; }
  body:not(.high-contrast) .nav-item.active { border-bottom-color: #7fa6ff; }
}


/* ====================================================================
   ACESSIBILIDADE: tamanho da letra em níveis, tema escuro e alto contraste
   ==================================================================== */

/* A escala é aplicada no <html>, então todo texto em rem acompanha */
body { font-size: 1rem; }
html.fs-1 { font-size: 112.5%; }
html.fs-2 { font-size: 125%; }
html.fs-3 { font-size: 143.75%; }
html[class*="fs-"] { --sidebar-w: 17rem; }
.sidebar { top: 3.5rem; height: calc(100vh - 3.5rem); }
.auth-layout, .app-shell { min-height: calc(100vh - 3.5rem); }
html.fs-2 .stats-grid, html.fs-3 .stats-grid { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
html.fs-2 .modules-grid, html.fs-3 .modules-grid { grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); }
html[class*="fs-"] .acc-btn, html[class*="fs-"] .nav-item { min-height: 2.75rem; }
@media (max-width: 1000px) { .sidebar { top: auto; height: auto; } }

/* Controles da barra superior */
.accessibility-controls { flex-wrap: wrap; justify-content: flex-end; }
.font-stepper {
  display: inline-flex; align-items: center; gap: 4px;
  border: 1px solid var(--border-strong); border-radius: var(--radius);
  padding: 2px;
}
.acc-btn-icon { min-width: 40px; justify-content: center; font-weight: 700; padding: 5px 8px; border-color: transparent; }
.acc-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.font-level { min-width: 4.4rem; text-align: center; font-size: 0.8rem; font-weight: 600; }
.acc-btn[aria-pressed="true"] { background: var(--primary-light); border-color: var(--primary); color: var(--primary); font-weight: 700; }

body:not(.high-contrast) .font-stepper { border-color: rgba(234, 240, 255, 0.35); }
body:not(.high-contrast) .font-level { color: #eaf0ff; }
body:not(.high-contrast) .acc-btn-icon { border-color: transparent; }
body:not(.high-contrast) .acc-btn[aria-pressed="true"] { background: #eaf0ff; color: #0b1f4d; border-color: #eaf0ff; }

/* ---------- TEMA ESCURO ---------- */
body.dark-mode:not(.high-contrast) {
  --bg-page: #0c1424; --bg-card: #15203a; --bg-subtle: #1b2a4a; --bg-hover: #23365d; --bg-input: #0f1a31;
  --text-main: #e8eefc; --text-muted: #a6b5d6; --text-dim: #7a8aad;
  --border-color: #2a3a60; --border-subtle: #22304f; --border-strong: #3d5084;
  --focus-ring: #8fb0fa;
  --primary: #6f98f5; --primary-hover: #8fb0fa; --primary-dark: #dbe6ff;
  --primary-light: #1d2f58; --primary-border: #34508f; --text-on-primary: #0b1633;
  --success: #7fd29a; --success-bg: #12301f; --success-border: #2c6b45;
  --warning: #f0c36a; --warning-bg: #3a2c0f; --warning-border: #7a5c1e;
  --danger: #ff9a92; --danger-bg: #3b1613; --danger-border: #7f2f2a;
  --info: #6cc4e0; --info-bg: #0f2f3b; --info-border: #2a6578;
  --violet: #bba6ee; --violet-bg: #251c42; --violet-border: #4d3d86;
  background: #0c1424; color: var(--text-main);
}
body.dark-mode:not(.high-contrast) .top-bar { background: #070e1c; border-bottom-color: #1b2a4a; }
body.dark-mode:not(.high-contrast) .sidebar { background: #0a1325; }
body.dark-mode:not(.high-contrast) .nav-item.active { background: #23365d; color: #ffffff; border-left-color: #6f98f5; }
body.dark-mode:not(.high-contrast) .page-header { border-bottom-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .role-context-banner,
body.dark-mode:not(.high-contrast) .stat-card,
body.dark-mode:not(.high-contrast) .quick-action-btn,
body.dark-mode:not(.high-contrast) .widget-card,
body.dark-mode:not(.high-contrast) .feed-notice-card,
body.dark-mode:not(.high-contrast) .feed-delivery-item,
body.dark-mode:not(.high-contrast) .notice-card,
body.dark-mode:not(.high-contrast) .area-manage-card,
body.dark-mode:not(.high-contrast) .form-mini,
body.dark-mode:not(.high-contrast) .overview-footer-support,
body.dark-mode:not(.high-contrast) .table-responsive { background: #15203a; border-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .quick-action-btn:hover,
body.dark-mode:not(.high-contrast) .feed-notice-card:hover { border-color: #6f98f5; background: #1a2847; }
body.dark-mode:not(.high-contrast) .widget-header { background: #0f182e; border-bottom-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .feed-agenda-item { background: #111a30; border-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .feed-agenda-item:hover { background: #1a2847; border-color: #6f98f5; }
body.dark-mode:not(.high-contrast) .agenda-item-date { background: #0c1424; border-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .role-context-meta strong,
body.dark-mode:not(.high-contrast) .action-info strong,
body.dark-mode:not(.high-contrast) .widget-title,
body.dark-mode:not(.high-contrast) .feed-notice-title,
body.dark-mode:not(.high-contrast) .delivery-item-row strong,
body.dark-mode:not(.high-contrast) .agenda-item-title-row strong,
body.dark-mode:not(.high-contrast) .agenda-item-date strong { color: #ffffff; }
body.dark-mode:not(.high-contrast) .role-context-body p,
body.dark-mode:not(.high-contrast) .action-info span,
body.dark-mode:not(.high-contrast) .widget-subtitle,
body.dark-mode:not(.high-contrast) .feed-notice-text,
body.dark-mode:not(.high-contrast) .delivery-item-sub,
body.dark-mode:not(.high-contrast) .agenda-item-solicitante,
body.dark-mode:not(.high-contrast) .agenda-item-date span { color: #a6b5d6; }
body.dark-mode:not(.high-contrast) .btn-widget-link,
body.dark-mode:not(.high-contrast) .btn-feed-link { color: #8faee5; }
body.dark-mode:not(.high-contrast) .overview-empty-state { background: #111a30; border-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .empty-state-icon { background: #15203a; border-color: #2a3a60; color: #6f98f5; }
body.dark-mode:not(.high-contrast) .empty-state-title { color: #ffffff; }
body.dark-mode:not(.high-contrast) .form-mini { border-left-color: #6f98f5; }
body.dark-mode:not(.high-contrast) .window-frame { background: #101a30; border-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .window-header { background: #070e1c; }
body.dark-mode:not(.high-contrast) .data-table th { background: #1f2f55; color: #dbe6ff; border-bottom-color: #34508f; }
body.dark-mode:not(.high-contrast) .data-table tbody tr:nth-child(even) { background: #121d36; }
body.dark-mode:not(.high-contrast) .data-table tbody tr:hover { background: #1d2c4f; }
body.dark-mode:not(.high-contrast) .data-table td { border-bottom-color: #22304f; }
body.dark-mode:not(.high-contrast) .filter-bar,
body.dark-mode:not(.high-contrast) .notice-empty { background: #15203a; border-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .badge-status.vago { background: #23365d; color: #c4d2ef; border-color: #3d5084; }
body.dark-mode:not(.high-contrast) .auth-hero { background: #070e1c; border-right-color: #1b2a4a; }
body.dark-mode:not(.high-contrast) .brand-monogram .monogram-frame { border-color: rgba(255, 255, 255, 0.25); color: #ffffff; background: rgba(255, 255, 255, 0.04); }
body.dark-mode:not(.high-contrast) .hero-brand-title { color: #ffffff; }
body.dark-mode:not(.high-contrast) .hero-brand-sub { color: #8faee5; }
body.dark-mode:not(.high-contrast) .hero-spec { background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.08); }
body.dark-mode:not(.high-contrast) .hero-spec-tag { color: #8faee5; }
body.dark-mode:not(.high-contrast) .hero-spec-meta { color: #d0def5; }
body.dark-mode:not(.high-contrast) .service-content strong { color: #ffffff; }
body.dark-mode:not(.high-contrast) .service-content span { color: #a6b5d6; }
body.dark-mode:not(.high-contrast) .service-bullet { background: #6f98f5; }
body.dark-mode:not(.high-contrast) .hero-foot { border-top-color: rgba(255, 255, 255, 0.08); color: #8faee5; }
body.dark-mode:not(.high-contrast) .auth-panel { background: #0c1424; }
body.dark-mode:not(.high-contrast) .auth-card { background: #15203a; border-color: #2a3a60; border-top-color: #6f98f5; }
body.dark-mode:not(.high-contrast) .auth-kicker { color: #8faee5; }
body.dark-mode:not(.high-contrast) .auth-title { color: #ffffff; }
body.dark-mode:not(.high-contrast) .auth-subtitle { color: #a6b5d6; }
body.dark-mode:not(.high-contrast) .caps-warning { background: #261e0d; border-color: #594518; color: #ffd966; }
body.dark-mode:not(.high-contrast) .form-group label { color: #e8eefc; }
body.dark-mode:not(.high-contrast) .input-wrapper input { background: #0f1a31; border-color: #2a3a60; color: #e8eefc; }
body.dark-mode:not(.high-contrast) .auth-help-note { color: #8faee5; }
body.dark-mode:not(.high-contrast) .demo-profiles { border-top-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .demo-title { color: #a6b5d6; }
body.dark-mode:not(.high-contrast) .btn-chip { background: #1b2a4a; border-color: #2a3a60; }
body.dark-mode:not(.high-contrast) .btn-chip .chip-role { color: #ffffff; }
body.dark-mode:not(.high-contrast) .btn-chip .chip-scope { color: #a6b5d6; }
body.dark-mode:not(.high-contrast) .btn-chip:hover { background: #23365d; border-color: #6f98f5; }
body.dark-mode:not(.high-contrast) .btn-chip:hover .chip-role { color: #6f98f5; }
body.dark-mode:not(.high-contrast) .btn-chip.active-profile { background: #1d4ed8; border-color: #1d4ed8; }
body.dark-mode:not(.high-contrast) .btn-chip.active-profile .chip-role { color: #ffffff; }
body.dark-mode:not(.high-contrast) .btn-chip.active-profile .chip-scope { color: #d0def5; }
body.dark-mode:not(.high-contrast) .data-table tbody tr:hover td { color: #ffffff; }
body.dark-mode:not(.high-contrast) .btn-secondary:hover,
body.dark-mode:not(.high-contrast) .notice-link-btn:hover { color: #0b1633; }

/* ---------- ALTO CONTRASTE (WCAG AAA: branco/amarelo sobre preto) ---------- */
body.high-contrast, body.high-contrast .app-main, body.high-contrast .auth-panel { background: #000; color: #fff; }
body.high-contrast a, body.high-contrast .notice-message a { color: #ffff00; text-decoration: underline; }
body.high-contrast :focus-visible { outline: 4px solid #ffff00; outline-offset: 3px; }
body.high-contrast .top-bar { background: #000; border-bottom: 3px solid #ffff00; }
body.high-contrast .brand-mini { color: #fff; }
body.high-contrast .brand-dot { background: #ffff00; }
body.high-contrast .acc-btn { background: #000; color: #fff; border: 2px solid #fff; font-weight: 700; }
body.high-contrast .acc-btn:hover { background: #fff; color: #000; }
body.high-contrast .acc-btn[aria-pressed="true"] { background: #ffff00; color: #000; border-color: #ffff00; }
body.high-contrast .font-stepper { border: 2px solid #fff; }
body.high-contrast .font-level { color: #fff; }

body.high-contrast .sidebar { background: #000; border-right: 3px solid #fff; }
body.high-contrast .sidebar-brand-text span, body.high-contrast .side-label { color: #ffff66; }
body.high-contrast .nav-item { color: #fff; border-left: 4px solid transparent; font-weight: 600; }
body.high-contrast .nav-item:hover { background: #fff; color: #000; }
body.high-contrast .nav-item.active { background: #ffff00; color: #000; border-left-color: #fff; font-weight: 800; outline: none; }
body.high-contrast .nav-item .ico { opacity: 1; }
body.high-contrast .user-avatar { background: #ffff00; color: #000; }
body.high-contrast .btn-logout { border: 2px solid #fff; color: #fff; }

body.high-contrast .stat-card,
body.high-contrast .quick-action-btn,
body.high-contrast .widget-card,
body.high-contrast .feed-notice-card,
body.high-contrast .feed-agenda-item,
body.high-contrast .feed-delivery-item,
body.high-contrast .overview-empty-state,
body.high-contrast .overview-footer-support,
body.high-contrast .notice-card,
body.high-contrast .area-manage-card,
body.high-contrast .form-mini,
body.high-contrast .role-context-banner,
body.high-contrast .table-responsive,
body.high-contrast .filter-bar,
body.high-contrast .info-box-audit,
body.high-contrast .notice-empty { background: #000; border: 2px solid #fff; box-shadow: none; }
body.high-contrast .widget-header { background: #000; border-bottom: 2px solid #fff; }
body.high-contrast .stat-card { border-top: 6px solid #ffff00; }
body.high-contrast .notice-card { border-left: 8px solid #ffff00; }
body.high-contrast .notice-card.urgente { border-left-color: #ff8080; }
body.high-contrast .notice-card.geral { border-left-color: #66ff99; }
body.high-contrast .quick-action-btn:hover,
body.high-contrast .feed-notice-card:hover,
body.high-contrast .feed-agenda-item:hover,
body.high-contrast .feed-delivery-item:hover { border-color: #ffff00; transform: none; }
body.high-contrast .stat-card:hover { transform: none; }
body.high-contrast .action-info strong,
body.high-contrast .role-context-meta strong,
body.high-contrast .widget-title,
body.high-contrast .feed-notice-title,
body.high-contrast .delivery-item-row strong,
body.high-contrast .agenda-item-title-row strong,
body.high-contrast .agenda-item-date strong,
body.high-contrast .stat-value, body.high-contrast .page-title, body.high-contrast .window-title,
body.high-contrast .notice-title { color: #fff; }
body.high-contrast .role-context-body p,
body.high-contrast .action-info span,
body.high-contrast .widget-subtitle,
body.high-contrast .feed-notice-text,
body.high-contrast .delivery-item-sub,
body.high-contrast .agenda-item-solicitante,
body.high-contrast .agenda-item-date span { color: #ffff66; }
body.high-contrast .btn-widget-link,
body.high-contrast .btn-feed-link { color: #ffff00; font-weight: 800; }

body.high-contrast .window-frame { background: #000; border: 3px solid #fff; }
body.high-contrast .window-header { background: #000; border-bottom: 3px solid #ffff00; }
body.high-contrast .window-sub, body.high-contrast .breadcrumb-link { color: #ffff66; }
body.high-contrast .breadcrumb-current { color: #fff; }
body.high-contrast .btn-window-back { background: #000; color: #fff; border: 2px solid #fff; }
body.high-contrast .btn-window-back:hover { background: #fff; color: #000; }

body.high-contrast .data-table th { background: #000; color: #ffff00; border-bottom: 3px solid #ffff00; }
body.high-contrast .data-table td { border-bottom: 1px solid #fff; color: #fff; }
body.high-contrast .data-table tbody tr:nth-child(even) { background: #111; }
body.high-contrast .data-table tbody tr:hover { background: #222; }

body.high-contrast .btn-primary, body.high-contrast .btn-primary-sm, body.high-contrast .btn-dialog-primary {
  background: #ffff00; color: #000; border: 2px solid #ffff00; font-weight: 800; box-shadow: none;
}
body.high-contrast .btn-primary:hover, body.high-contrast .btn-primary-sm:hover, body.high-contrast .btn-dialog-primary:hover { background: #fff; border-color: #fff; color: #000; }
body.high-contrast .btn-secondary, body.high-contrast .btn-secondary-sm, body.high-contrast .btn-dialog-secondary, body.high-contrast .btn-chip {
  background: #000; color: #ffff00; border: 2px solid #ffff00; font-weight: 700;
}
body.high-contrast .btn-secondary:hover, body.high-contrast .btn-secondary-sm:hover,
body.high-contrast .btn-dialog-secondary:hover, body.high-contrast .btn-chip:hover { background: #ffff00; color: #000; }
body.high-contrast .btn-chip.active-profile { background: #ffff00; color: #000; }
body.high-contrast .btn-action-deliver, body.high-contrast .btn-action-danger,
body.high-contrast .btn-action-primary, body.high-contrast .btn-action-warning { border-width: 2px; background: #000; font-weight: 800; }
body.high-contrast .btn-action-deliver:hover, body.high-contrast .btn-action-danger:hover,
body.high-contrast .btn-action-primary:hover, body.high-contrast .btn-action-warning:hover { color: #000; }
body.high-contrast .btn-action-primary { color: #ffff00; border-color: #ffff00; }
body.high-contrast .btn-action-primary:hover { background: #ffff00; }
body.high-contrast .notice-link-btn { background: #000; color: #ffff00; border: 2px solid #ffff00; font-weight: 700; }
body.high-contrast .notice-link-btn:hover { background: #ffff00; color: #000; }

body.high-contrast .badge-status, body.high-contrast .notice-cat-badge { border-width: 2px; font-weight: 800; background: #000; }
body.high-contrast .input-wrapper input, body.high-contrast .form-group-mini input,
body.high-contrast .form-group-mini select, body.high-contrast .form-group-mini textarea,
body.high-contrast .custom-dialog-input, body.high-contrast .filter-group select,
body.high-contrast .area-field-item input { background: #000; color: #fff; border: 2px solid #fff; }
body.high-contrast input:focus, body.high-contrast select:focus, body.high-contrast textarea:focus { border-color: #ffff00; box-shadow: 0 0 0 3px #ffff00; }
body.high-contrast .input-wrapper input::placeholder { color: #cccc66; }
body.high-contrast .auth-hero { background: #000; border-right: 3px solid #ffff00; }
body.high-contrast .brand-monogram .monogram-frame { border: 2px solid #ffff00; color: #ffff00; background: #000; }
body.high-contrast .hero-brand { border-bottom-color: #ffff00; }
body.high-contrast .hero-brand-title { color: #fff; }
body.high-contrast .hero-brand-sub { color: #ffff66; }
body.high-contrast .hero-spec { background: #000; border: 2px solid #fff; }
body.high-contrast .hero-spec-tag { color: #ffff00; }
body.high-contrast .hero-spec-meta { color: #fff; }
body.high-contrast .service-bullet { background: #ffff00; }
body.high-contrast .service-content strong { color: #ffff00; }
body.high-contrast .service-content span { color: #fff; }
body.high-contrast .hero-foot { border-top-color: #ffff00; color: #fff; }
body.high-contrast .status-indicator-dot { background: #ffff00; }
body.high-contrast .foot-version { color: #ffff66; }
body.high-contrast .auth-card { background: #000; border: 3px solid #fff; border-top: 5px solid #ffff00; box-shadow: none; }
body.high-contrast .auth-kicker { color: #ffff00; }
body.high-contrast .auth-title { color: #fff; }
body.high-contrast .auth-subtitle { color: #ffff66; }
body.high-contrast .caps-warning { background: #000; border: 2px solid #ffff00; color: #ffff00; }
body.high-contrast .auth-help-note { color: #fff; }
body.high-contrast .demo-profiles { border-top-color: #fff; }
body.high-contrast .demo-title { color: #ffff66; }
body.high-contrast .btn-chip { background: #000; border: 2px solid #fff; }
body.high-contrast .btn-chip .chip-role { color: #ffff00; }
body.high-contrast .btn-chip .chip-scope { color: #fff; }
body.high-contrast .btn-chip:hover { background: #ffff00; border-color: #ffff00; }
body.high-contrast .btn-chip:hover .chip-role, body.high-contrast .btn-chip:hover .chip-scope { color: #000; }
body.high-contrast .btn-chip.active-profile { background: #ffff00; border-color: #ffff00; }
body.high-contrast .btn-chip.active-profile .chip-role, body.high-contrast .btn-chip.active-profile .chip-scope { color: #000; }
body.high-contrast .custom-dialog-footer, body.high-contrast .ticket-reply-box { background: #000; }
body.high-contrast .ticket-reply-box { border-left: 6px solid #ffff00; border: 2px solid #fff; border-left-width: 6px; }
body.high-contrast .custom-dialog-card { background: #000; border: 3px solid #ffff00; }
body.high-contrast .toast { background: #000; color: #fff; border: 3px solid #ffff00; }
